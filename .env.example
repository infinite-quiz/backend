# App
APP_NAME=Infinite Quiz API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local; switch to Postgres in production)
DATABASE_URL=sqlite:///./quiz.db
# DATABASE_URL=postgresql+psycopg://quiz:quiz@localhost:5432/quiz

# CORS (frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Quiz defaults
DEFAULT_LIVES=3
MAX_QUESTIONS_PER_REQUEST=20

# ML generator (stub | http)
GENERATOR_MODE=stub
# GENERATOR_URL=http://localhost:8001/generate
# GENERATOR_TIMEOUT_SEC=30
