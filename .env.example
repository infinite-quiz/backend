# App
APP_NAME=Infinite Quiz API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local; switch to Postgres in production)
DATABASE_URL=sqlite:///./quiz.db
# DATABASE_URL=postgresql+psycopg://quiz:quiz@localhost:5432/quiz

# CORS (frontend origins, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Quiz defaults
DEFAULT_LIVES=3
MAX_QUESTIONS_PER_REQUEST=20

# ML generator (stub | http)
GENERATOR_MODE=http
GENERATOR_URL=http://127.0.0.1:8001/generate
GENERATOR_TIMEOUT_SEC=45
GENERATOR_RANKED_TIMEOUT_SEC=40

# Ranked
RANKED_ROUND_SECONDS=20
RANKED_DEFAULT_ROUNDS=5
RANKED_MAX_BANS=1
RANKED_TOPIC_CANDIDATES=Космос,История,Наука,Кино,Спорт
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=ws://localhost:8000

# Auth
SESSION_SECRET=dev-change-me
SESSION_TTL_SEC=1209600
